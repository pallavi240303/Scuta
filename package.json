{
  "name": "pennywise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun run build && bun scripts/run-tests.ts",
    "test:watch": "bun run build && bun test --watch",
    "test:coverage": "bun run build && bun scripts/run-tests.ts --coverage && bun scripts/coverage-inventory.ts",
    "typecheck": "bun run --bun tsc --noEmit",
    "lint": "bun run --bun eslint . --max-warnings 0",
    "format:check": "bun run --bun prettier --check .",
    "format": "bun run --bun prettier --write .",
    "build": "bun run --bun tsc -p packages/core/tsconfig.build.json",
    "demo": "bun run build && bun apps/example/src/static-policy-demo.ts",
    "smoke": "bun scripts/verify-built-package.ts",
    "check": "bun run build && bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.2.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
